<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A minimal stack theme. Compose owns all visual styling; the XML theme only
      controls the window background before the first frame is drawn.
    -->
    <style name="Theme.LexiFlash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
