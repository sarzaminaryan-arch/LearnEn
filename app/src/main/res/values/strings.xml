    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_app_section">About this app</string>
    <string name="about_body">LexiFlash Persian teaches English through sentence-level flashcards, quizzes and spaced repetition. The core deck is built from openly licensed Tatoeba sentences paired with human translations.</string>
    <string name="about_disclaimer">Not affiliated with TED, Interstellar or any rights holder.</string>
    <string name="about_data_section">Data and attribution</string>
    <string name="about_tatoeba">Tatoeba</string>
    <string name="about_tatoeba_body">Example sentences come from Tatoeba (https://tatoeba.org), used under CC BY 2.0 FR and, for part of the corpus, CC0 1.0. Translations were contributed by Tatoeba volunteers.</string>
    <string name="about_licenses_section">Open source licenses</string>
    <string name="about_licenses_body">This app is licensed under the Apache License 2.0. It uses AndroidX, Jetpack Compose, Room, Kotlin, kotlinx.coroutines and DataStore, all under the Apache License 2.0. The online build also uses ML Kit from Google, under the Google APIs Terms of Service.</string>
    <string name="about_privacy">Privacy</string>
    <string name="about_privacy_body">No analytics, no advertising and no tracking. Study data never leaves your device. The offline build has no network permission at all.</string>
    <string name="about_open_tatoeba">Open tatoeba.org</string>
